generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  TRANSFERRED
  GRADUATED
  ARCHIVED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LEFT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  JAZZCASH
  EASYPAISA
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  VERIFIED
  REJECTED
}

enum TestType {
  TEST
  EXAM
  QUIZ
  ASSIGNMENT
}

enum NoticeStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  teacher   Teacher?
  student   Student?
  parent    Parent?
  auditLogs AuditLog[]

  @@index([role])
  @@index([status])
}

model Parent {
  id         String   @id @default(cuid())
  userId     String   @unique
  name       String
  phone      String?
  email      String?
  address    String?
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationships ParentStudent[]

  @@index([name])
  @@index([phone])
}

model Student {
  id               String        @id @default(cuid())
  userId           String?       @unique
  studentId        String        @unique
  admissionNumber  String        @unique
  fullName         String
  fatherName       String?
  motherName       String?
  guardianName     String?
  dateOfBirth      DateTime?
  gender           Gender?
  photoUrl         String?
  rollNumber       String?
  admissionDate    DateTime      @default(now())
  contactNumber    String?
  parentContact    String?
  address          String?
  emergencyContact String?
  medicalNotes     String?
  previousSchool   String?
  status           StudentStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user            User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments     Enrollment[]
  parentRelations ParentStudent[]
  attendance      Attendance[]
  feeVouchers     FeeVoucher[]
  feePayments     FeePayment[]
  testAttempts    TestAttempt[]
  marks           Mark[]
  reportCards     ReportCard[]
  assignments     AssignmentSubmission[]
  notifications   Notification[]

  @@index([fullName])
  @@index([fatherName])
  @@index([status])
}

model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  studentId String
  relation  String?
  isPrimary Boolean @default(false)

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([studentId])
}

model Teacher {
  id               String           @id @default(cuid())
  userId           String           @unique
  teacherId        String           @unique
  name             String
  photoUrl         String?
  qualification    String?
  contactNumber    String?
  email            String?
  address          String?
  joiningDate      DateTime?
  employmentStatus EmploymentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes     ClassRoom[]         @relation("ClassTeacher")
  subjects    TeacherSubject[]
  attendance  TeacherAttendance[]
  tests       Test[]
  notices     Notice[]            @relation("NoticeCreator")
  timetables  Timetable[]
  assignments Assignment[]        @relation("AssignmentTeacher")

  @@index([name])
  @@index([employmentStatus])
}

model ClassRoom {
  id             String   @id @default(cuid())
  name           String
  code           String?  @unique
  classTeacherId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classTeacher  Teacher?       @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  sections      Section[]
  subjects      ClassSubject[]
  tests         Test[]
  enrollments   Enrollment[]
  timetables    Timetable[]
  feeStructures FeeStructure[]
  assignments   Assignment[]

  @@index([name])
}

model Section {
  id        String   @id @default(cuid())
  name      String
  classId   String
  createdAt DateTime @default(now())

  classRoom   ClassRoom    @relation(fields: [classId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([classId, name])
}

model Subject {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique
  totalMarks   Int      @default(100)
  passingMarks Int      @default(40)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  classes    ClassSubject[]
  teachers   TeacherSubject[]
  marks      Mark[]
  tests      Test[]
  timetables Timetable[]

  @@index([name])
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  enrollments Enrollment[]
  feeVouchers FeeVoucher[]
  tests       Test[]
  reportCards ReportCard[]
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  classId    String
  sectionId  String
  sessionId  String
  rollNumber String?
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)

  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom ClassRoom       @relation(fields: [classId], references: [id], onDelete: Restrict)
  section   Section         @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([studentId, sessionId])
  @@index([classId, sectionId])
  @@index([sessionId])
}

model ClassSubject {
  id        String @id @default(cuid())
  classId   String
  subjectId String

  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model TeacherSubject {
  id        String @id @default(cuid())
  teacherId String
  subjectId String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  markedBy  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([date])
  @@index([studentId, date])
}

model TeacherAttendance {
  id        String           @id @default(cuid())
  teacherId String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([date])
}

model FeeType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  structures FeeStructure[]
  items      FeeVoucherItem[]
}

model FeeStructure {
  id            String    @id @default(cuid())
  feeTypeId     String
  classId       String?
  amount        Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)

  feeType   FeeType    @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)
  classRoom ClassRoom? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([feeTypeId])
  @@index([classId])
}

model FeeVoucher {
  id              String    @id @default(cuid())
  voucherNumber   String    @unique
  studentId       String
  sessionId       String
  feeMonth        DateTime
  dueDate         DateTime
  subtotal        Decimal   @db.Decimal(12, 2)
  discount        Decimal   @default(0) @db.Decimal(12, 2)
  lateFee         Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal   @db.Decimal(12, 2)
  paidAmount      Decimal   @default(0) @db.Decimal(12, 2)
  remainingAmount Decimal   @db.Decimal(12, 2)
  status          FeeStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student  Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  session  AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  items    FeeVoucherItem[]
  payments FeePayment[]

  @@index([studentId])
  @@index([feeMonth])
  @@index([status])
}

model FeeVoucherItem {
  id          String  @id @default(cuid())
  voucherId   String
  feeTypeId   String
  description String?
  amount      Decimal @db.Decimal(12, 2)

  voucher FeeVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  feeType FeeType    @relation(fields: [feeTypeId], references: [id], onDelete: Restrict)

  @@index([voucherId])
}

model PaymentMethodConfig {
  id           String        @id @default(cuid())
  name         String
  method       PaymentMethod
  instructions String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
}

model FeePayment {
  id             String        @id @default(cuid())
  receiptNumber  String        @unique
  voucherId      String
  studentId      String
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  status         PaymentStatus @default(SUCCESS)
  transactionRef String?
  bankName       String?
  receiptFileUrl String?
  paidAt         DateTime      @default(now())
  verifiedAt     DateTime?
  notes          String?

  voucher FeeVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([method, transactionRef])
  @@index([studentId])
  @@index([paidAt])
  @@index([status])
}

model Test {
  id              String    @id @default(cuid())
  title           String
  description     String?
  type            TestType  @default(TEST)
  classId         String
  subjectId       String
  teacherId       String
  sessionId       String
  totalMarks      Int
  passingMarks    Int
  testDate        DateTime
  startTime       DateTime?
  durationMinutes Int?
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  classRoom ClassRoom       @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher   Teacher         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  questions Question[]
  attempts  TestAttempt[]
  marks     Mark[]

  @@index([classId])
  @@index([subjectId])
  @@index([testDate])
}

model Question {
  id            String  @id @default(cuid())
  testId        String
  questionText  String
  questionType  String
  marks         Int
  options       Json?
  correctAnswer String?
  sortOrder     Int     @default(0)

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model TestAttempt {
  id          String    @id @default(cuid())
  testId      String
  studentId   String
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Decimal?  @db.Decimal(8, 2)
  isSubmitted Boolean   @default(false)

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
  @@index([studentId])
}

model Mark {
  id        String  @id @default(cuid())
  testId    String
  studentId String
  subjectId String
  obtained  Decimal @db.Decimal(8, 2)
  remarks   String?

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([testId, studentId])
  @@index([studentId])
}

model ReportCard {
  id               String   @id @default(cuid())
  studentId        String
  sessionId        String
  examName         String
  totalMarks       Decimal  @db.Decimal(10, 2)
  obtainedMarks    Decimal  @db.Decimal(10, 2)
  percentage       Decimal  @db.Decimal(6, 2)
  grade            String?
  attendancePct    Decimal? @db.Decimal(6, 2)
  teacherRemarks   String?
  principalRemarks String?
  createdAt        DateTime @default(now())

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([studentId, sessionId, examName])
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  classId     String
  subjectId   String
  teacherId   String
  dueDate     DateTime?
  fileUrl     String?
  createdAt   DateTime  @default(now())

  classRoom   ClassRoom              @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher     Teacher                @relation("AssignmentTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  submittedAt  DateTime @default(now())
  marks        Decimal? @db.Decimal(8, 2)
  feedback     String?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Timetable {
  id        String  @id @default(cuid())
  classId   String
  subjectId String
  teacherId String
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?

  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@index([classId, dayOfWeek])
}

model Notice {
  id            String       @id @default(cuid())
  title         String
  content       String
  status        NoticeStatus @default(DRAFT)
  imageUrl      String?
  attachmentUrl String?
  publishDate   DateTime?
  expiryDate    DateTime?
  targetClassId String?
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy Teacher @relation("NoticeCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([publishDate])
}

model Media {
  id           String    @id @default(cuid())
  title        String
  type         MediaType
  url          String
  thumbnailUrl String?
  description  String?
  isPublished  Boolean   @default(false)
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  studentId String?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, isRead])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model SyncQueue {
  id        String     @id @default(cuid())
  entity    String
  entityId  String
  operation String
  payload   Json
  status    SyncStatus @default(PENDING)
  attempts  Int        @default(0)
  lastError String?
  createdAt DateTime   @default(now())
  syncedAt  DateTime?

  @@index([status])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}
